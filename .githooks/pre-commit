#!/bin/sh
# Pre-commit hook: the commit is aborted unless the test suite passes and the
# CookedTree search keeps 100% line + branch coverage.
#
# One-time setup per clone:   git config core.hooksPath .githooks
# Skip in an emergency:       git commit --no-verify   (avoid it)

# GUI git clients often start with a minimal PATH that does not contain uv.
PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"

cd "$(git rev-parse --show-toplevel)" || exit 1

if ! command -v uv >/dev/null 2>&1; then
    echo "pre-commit: 'uv' not found in PATH, cannot run the tests." >&2
    exit 1
fi

echo "pre-commit: running tests..."
if ! uv run pytest -q --cov=tablut.cooked_tree --cov-branch --cov-fail-under=100; then
    echo >&2
    echo "pre-commit: tests failed (or coverage < 100%). Commit aborted." >&2
    exit 1
fi
